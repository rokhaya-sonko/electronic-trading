    "                  timing_costs['cumulative_cost_bps'], alpha=0.3)\n",
    "ax2.set_ylabel('Cumulative Timing Cost (bps)')\n",
    "ax2.set_xlabel('Time')\n",
    "ax2.set_title('Cumulative Timing Cost')\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Execution Quality Score\n",
    "\n",
    "Calculate a composite quality score for the execution."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate execution quality score\n",
    "fill_rate = executions['execution_volume'].sum() / total_order_size\n",
    "speed_score = 0.9  # Simulated speed score\n",
    "\n",
    "quality_score = calculate_execution_quality_score(\n",
    "    slippage_bps=slippage.mean(),\n",
    "    market_impact_bps=vwap_results['slippage_bps'],\n",
    "    fill_rate=fill_rate,\n",
    "    speed_score=speed_score\n",
    ")\n",
    "\n",
    "print('Execution Quality Assessment:')\n",
    "print('=' * 60)\n",
    "print(f'\\nComponent Scores:')\n",
    "print(f'  Average Slippage: {slippage.mean():.2f} bps')\n",
    "print(f'  Market Impact: {vwap_results[\"slippage_bps\"]:.2f} bps')\n",
    "print(f'  Fill Rate: {fill_rate:.2%}')\n",
    "print(f'  Speed Score: {speed_score:.2f}')\n",
    "print(f'\\n{"="*60}')\n",
    "print(f'Overall Quality Score: {quality_score:.2f} / 100')\n",
    "print(f'{"="*60}')\n",
    "\n",
    "# Interpret score\n",
    "if quality_score >= 80:\n",
    "    rating = 'Excellent'\n",
    "elif quality_score >= 70:\n",
    "    rating = 'Good'\n",
    "elif quality_score >= 60:\n",
    "    rating = 'Fair'\n",
    "else:\n",
    "    rating = 'Needs Improvement'\n",
    "\n",
    "print(f'\\nRating: {rating}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize quality components\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "components = ['Slippage\\nScore', 'Impact\\nScore', 'Fill Rate\\nScore', 'Speed\\nScore', 'Overall']\n",
    "\n",
