    "    market_volumes=executions['market_volume'],\n",
    "    side='buy'\n",
    ")\n",
    "\n",
    "print('VWAP Performance Analysis:')\n",
    "print('=' * 60)\n",
    "print(f'Execution VWAP: ${vwap_results[\"execution_vwap\"]:.2f}')\n",
    "print(f'Market VWAP: ${vwap_results[\"market_vwap\"]:.2f}')\n",
    "print(f'Slippage vs VWAP: {vwap_results[\"slippage_bps\"]:.2f} bps')\n",
    "print(f'\\nVolume Statistics:')\n",
    "print(f'  Total Execution Volume: {vwap_results[\"total_exec_volume\"]:,.0f} shares')\n",
    "print(f'  Total Market Volume: {vwap_results[\"total_market_volume\"]:,.0f} shares')\n",
    "print(f'  Participation Rate: {vwap_results[\"participation_rate\"]:.2%}')\n",
    "print(f'\\nDollar Cost vs VWAP: ${(vwap_results[\"slippage_bps\"] / 10000) * vwap_results[\"market_vwap\"] * total_order_size:,.2f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate interval VWAP\n",
    "market_vwap = calculate_interval_vwap(\n",
