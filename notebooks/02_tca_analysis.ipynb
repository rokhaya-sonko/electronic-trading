    "ax2.legend()\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Slippage Analysis\n",
    "\n",
    "Analyze slippage for each execution."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate slippage for each execution\n",
    "slippage = calculate_slippage(\n",
    "    arrival_price=executions['market_price'],\n",
    "    execution_price=executions['execution_price'],\n",
    "    side='buy'\n",
    ")\n",
    "\n",
    "executions['slippage_bps'] = slippage\n",
    "\n",
    "print('Slippage Analysis:')\n",
    "print('=' * 60)\n",
    "print(f'Average Slippage: {slippage.mean():.2f} bps')\n",
    "print(f'Median Slippage: {slippage.median():.2f} bps')\n",
    "print(f'Min Slippage: {slippage.min():.2f} bps')\n",
    "print(f'Max Slippage: {slippage.max():.2f} bps')\n",
    "print(f'Std Dev: {slippage.std():.2f} bps')\n",
    "print(f'\\nPercentiles:')\n",
    "for pct in [25, 50, 75, 90, 95]:\n",
    "    print(f'  {pct}th percentile: {np.percentile(slippage, pct):.2f} bps')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize slippage\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 10))\n",
    "\n",
    "# Plot 1: Slippage over time\n",
    "ax1 = axes[0, 0]\n",
    "ax1.plot(executions['timestamp'], executions['slippage_bps'], \n",
    "         marker='o', linestyle='-', markersize=4)\n",
    "ax1.axhline(slippage.mean(), color='r', linestyle='--', \n",
    "            label=f'Mean: {slippage.mean():.2f} bps')\n",
    "ax1.fill_between(executions['timestamp'], 0, executions['slippage_bps'], alpha=0.3)\n",
    "ax1.set_ylabel('Slippage (bps)')\n",
    "ax1.set_title('Slippage Over Time')\n",
    "ax1.legend()\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: Slippage distribution\n",
    "ax2 = axes[0, 1]\n",
    "ax2.hist(slippage, bins=30, alpha=0.7, edgecolor='black')\n",
    "ax2.axvline(slippage.mean(), color='r', linestyle='--', linewidth=2, label='Mean')\n",
    "ax2.axvline(slippage.median(), color='g', linestyle='--', linewidth=2, label='Median')\n",
    "ax2.set_xlabel('Slippage (bps)')\n",
    "ax2.set_ylabel('Frequency')\n",
    "ax2.set_title('Slippage Distribution')\n",
    "ax2.legend()\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 3: Slippage vs execution size\n",
    "ax3 = axes[1, 0]\n",
    "ax3.scatter(executions['execution_volume'], executions['slippage_bps'], alpha=0.6)\n",
    "z = np.polyfit(executions['execution_volume'], executions['slippage_bps'], 1)\n",
    "p = np.poly1d(z)\n",
    "ax3.plot(executions['execution_volume'], p(executions['execution_volume']), \n",
    "         'r--', linewidth=2, label=f'Trend: y={z[0]:.6f}x+{z[1]:.2f}')\n",
    "ax3.set_xlabel('Execution Size (shares)')\n",
    "ax3.set_ylabel('Slippage (bps)')\n",
    "ax3.set_title('Slippage vs Execution Size')\n",
    "ax3.legend()\n",
    "ax3.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 4: Cumulative slippage cost\n",
    "ax4 = axes[1, 1]\n",
    "cumulative_cost = (slippage / 10000 * executions['market_price'] * executions['execution_volume']).cumsum()\n",
    "ax4.plot(executions['timestamp'], cumulative_cost, linewidth=2)\n",
    "ax4.fill_between(executions['timestamp'], 0, cumulative_cost, alpha=0.3)\n",
    "ax4.set_xlabel('Time')\n",
    "ax4.set_ylabel('Cumulative Cost ($)')\n",
    "ax4.set_title(f'Cumulative Slippage Cost: ${cumulative_cost.iloc[-1]:,.2f}')\n",
    "ax4.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
