    "print(f'  Final Cumulative: {timing_costs[\"cumulative_cost_bps\"].iloc[-1]:.2f}')\n",
    "print(f'\\nTotal Timing Cost: ${(timing_costs[\"cumulative_cost_bps\"].iloc[-1] / 10000) * decision_price * total_order_size:,.2f}')\n",
    "\n",
    "print('\\nFirst 5 executions:')\n",
    "print(timing_costs.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize timing costs\n",
