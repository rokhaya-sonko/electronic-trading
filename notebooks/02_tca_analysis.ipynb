   "source": [
    "# Transaction Cost Analysis (TCA)\n",
    "\n",
    "This notebook demonstrates Transaction Cost Analysis techniques:\n",
    "- Implementation Shortfall\n",
    "- VWAP Performance Analysis\n",
    "- Slippage Metrics\n",
    "- Market Impact Analysis\n",
    "\n",
    "TCA is essential for evaluating execution quality and optimizing trading strategies."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import sys\n",
    "sys.path.append('../src')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Import our custom modules\n",
    "from utils import generate_price_series, generate_trade_data\n",
    "from tca import (\n",
    "    calculate_implementation_shortfall,\n",
    "    calculate_vwap_performance,\n",
    "    calculate_slippage,\n",
    "    calculate_market_impact,\n",
    "    calculate_timing_cost,\n",
    "    calculate_execution_quality_score,\n",
    "    calculate_interval_vwap\n",
    ")\n",
    "\n",
    "# Set plotting style\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "\n",
    "print('✓ Libraries loaded successfully')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Generate Synthetic Execution Data\n",
    "\n",
    "We'll simulate a large order being executed over time."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate market data\n",
    "np.random.seed(42)\n",
    "n_periods = 500\n",
    "\n",
    "# Market prices\n",
    "market_prices = generate_price_series(\n",
    "    n_periods=n_periods,\n",
    "    initial_price=100.0,\n",
    "    mu=0.0001,\n",
    "    sigma=0.015,\n",
    "    seed=42\n",
    ")\n",
    "\n",
    "# Market volumes\n",
    "market_volumes = np.random.lognormal(mean=10, sigma=0.5, size=n_periods).astype(int)\n",
    "market_data = pd.DataFrame({\n",
    "    'price': market_prices.values,\n",
    "    'volume': market_volumes\n",
    "}, index=market_prices.index)\n",
    "\n",
    "# Simulate execution of a large order\n",
    "# Decision made at t=0, execution over first 100 periods\n",
    "decision_time = market_prices.index[0]\n",
    "decision_price = market_prices.iloc[0]\n",
    "execution_end = market_prices.index[100]\n",
    "final_price = market_prices.iloc[100]\n",
    "\n",
    "# Generate execution fills (gradually executed order)\n",
    "execution_window = market_prices.iloc[10:100]  # Start executing after 10 periods\n",
    "n_executions = len(execution_window)\n",
    "\n",
    "# Total order size\n",
    "total_order_size = 100000\n",
    "\n",
    "# Execution sizes (with some randomness)\n",
    "base_size = total_order_size / n_executions\n",
    "execution_sizes = np.random.normal(base_size, base_size * 0.3, n_executions)\n",
    "execution_sizes = np.abs(execution_sizes)\n",
    "execution_sizes = execution_sizes * total_order_size / execution_sizes.sum()  # Normalize\n",
    "\n",
    "# Execution prices (slightly worse than market due to impact)\n",
    "execution_prices = execution_window * (1 + np.random.uniform(0.0001, 0.0005, n_executions))\n",
    "\n",
    "# Create execution DataFrame\n",
    "executions = pd.DataFrame({\n",
    "    'timestamp': execution_window.index,\n",
    "    'execution_price': execution_prices.values,\n",
    "    'execution_volume': execution_sizes,\n",
    "    'market_price': execution_window.values,\n",
    "    'market_volume': market_data.loc[execution_window.index, 'volume'].values\n",
    "})\n",
    "\n",
    "print(f'Total Order Size: {total_order_size:,.0f} shares')\n",
    "print(f'Number of Executions: {len(executions)}')\n",
    "print(f'Decision Price: ${decision_price:.2f}')\n",
    "print(f'Final Price: ${final_price:.2f}')\n",
    "print(f'Average Execution Price: ${executions[\"execution_price\"].mean():.2f}')\n",
    "print(f'\\nExecution Summary:')\n",
    "print(executions.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Implementation Shortfall Analysis\n",
    "\n",
    "Implementation shortfall measures the total cost of execution relative to the decision price."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate implementation shortfall\n",
    "is_results = calculate_implementation_shortfall(\n",
    "    decision_price=decision_price,\n",
    "    execution_prices=executions['execution_price'],\n",
    "    execution_volumes=executions['execution_volume'],\n",
    "    final_price=final_price,\n",
    "    side='buy'\n",
    ")\n",
    "\n",
    "print('Implementation Shortfall Analysis:')\n",
    "print('=' * 60)\n",
    "print(f'Decision Price: ${is_results[\"decision_price\"]:.2f}')\n",
    "print(f'Avg Execution Price: ${is_results[\"avg_execution_price\"]:.2f}')\n",
    "print(f'Final Price: ${is_results[\"final_price\"]:.2f}')\n",
    "print(f'Total Volume: {is_results[\"total_volume\"]:,.0f} shares')\n",
    "print(f'\\nCost Breakdown (basis points):')\n",
    "print(f'  Execution Cost: {is_results[\"execution_cost_bps\"]:.2f} bps')\n",
    "print(f'  Opportunity Cost: {is_results[\"opportunity_cost_bps\"]:.2f} bps')\n",
    "print(f'  Total Cost: {is_results[\"total_cost_bps\"]:.2f} bps')\n",
    "print(f'\\nDollar Cost: ${(is_results[\"total_cost_bps\"] / 10000) * decision_price * total_order_size:,.2f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize implementation shortfall components\n",
    "fig, axes = plt.subplots(2, 1, figsize=(14, 10))\n",
    "\n",
    "# Plot 1: Price evolution and execution\n",
    "ax1 = axes[0]\n",
    "ax1.plot(market_prices.index[:150], market_prices.iloc[:150], \n",
    "         label='Market Price', linewidth=2, alpha=0.7)\n",
    "ax1.scatter(executions['timestamp'], executions['execution_price'], \n",
    "            c='red', s=30, label='Executions', zorder=5)\n",
    "ax1.axhline(decision_price, color='green', linestyle='--', \n",
    "            label=f'Decision Price: ${decision_price:.2f}')\n",
    "ax1.axhline(is_results['avg_execution_price'], color='red', linestyle='--',\n",
    "            label=f'Avg Exec Price: ${is_results[\"avg_execution_price\"]:.2f}')\n",
    "ax1.axvline(execution_window.index[0], color='gray', linestyle=':', alpha=0.5)\n",
    "ax1.axvline(execution_window.index[-1], color='gray', linestyle=':', alpha=0.5)\n",
    "ax1.set_ylabel('Price ($)')\n",
    "ax1.set_title('Implementation Shortfall: Price Evolution')\n",
    "ax1.legend()\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: Cost components\n",
    "ax2 = axes[1]\n",
    "components = ['Execution\\nCost', 'Opportunity\\nCost', 'Total\\nCost']\n",
    "values = [\n",
    "    is_results['execution_cost_bps'],\n",
    "    is_results['opportunity_cost_bps'],\n",
    "    is_results['total_cost_bps']\n",
    "]\n",
    "colors = ['#ff6b6b', '#feca57', '#ff9ff3']\n",
    "bars = ax2.bar(components, values, color=colors, alpha=0.7, edgecolor='black')\n",
    "\n",
    "# Add value labels on bars\n",
    "for bar, value in zip(bars, values):\n",
    "    height = bar.get_height()\n",
    "    ax2.text(bar.get_x() + bar.get_width()/2., height,\n",
    "             f'{value:.2f} bps',\n",
    "             ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "ax2.set_ylabel('Cost (basis points)')\n",
    "ax2.set_title('Implementation Shortfall Components')\n",
    "ax2.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. VWAP Performance Analysis\n",
    "\n",
    "Compare execution performance against Volume-Weighted Average Price benchmark."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate VWAP performance\n",
    "vwap_results = calculate_vwap_performance(\n",
    "    execution_prices=executions['execution_price'],\n",
