    "ax1.set_ylabel('Price ($)')\n",
    "ax1.set_title('VWAP Performance Analysis')\n",
    "ax1.legend()\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: Participation rate over time\n",
